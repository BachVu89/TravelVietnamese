; Dọc miền Việt — offline 3D exploration prototype
config_version=5

[application]
config/name="Dọc miền Việt 3D"
config/version="0.6.0"
config/icon="res://icon.svg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="Offline third-person exploration. Procedural illustrative scenes, not surveyed geography."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0
window/energy_saving/keep_screen_on=true

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=0
lights_and_shadows/directional_shadow/size=1024
anti_aliasing/quality/msaa_3d=0

[input_devices]
pointing/emulate_touch_from_mouse=false

[physics]
common/physics_ticks_per_second=60
common/physics_interpolation=true
